# Non-secret settings; export explicitly. Scripts never read .env files.
# Provision persistent directories once (never remove them during updates):
# install -d -m 0700 /srv/apex-redirect
# install -d -m 0700 -o 10001 -g 10001 /srv/apex-redirect/app
# install -d -m 0700 -o 10002 -g 10002 /srv/apex-redirect/caddy
APEX_DATA_DIR=/srv/apex-redirect
# Replace with YOUR accepted published image and its actual nonzero SHA-256 digest.
APP_IMAGE=registry.example.invalid/apex-redirect@sha256:REPLACE_WITH_VERIFIED_DIGEST
CADDY_IMAGE=registry.example.invalid/apex-redirect-caddy@sha256:REPLACE_WITH_VERIFIED_DIGEST
# Exact identity of YOUR approved signing workflow; never use an identity regexp.
RELEASE_CERTIFICATE_IDENTITY=https://github.com/OWNER/REPOSITORY/.github/workflows/release.yaml@refs/tags/vVERSION
# Both runtime images must be signed by this exact approved release identity.
# Omit IPv6 entirely until it is configured and verified end to end.
SERVICE_PUBLIC_IPS=REPLACE_WITH_REAL_PUBLIC_IPV4
MODE=selfhost
ALLOWED_DOMAINS=example.com
ACME_EMAIL=ops@example.com
# Untrusted staging certificates by default. Production requires explicit review.
ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
# Set only after staging and recovery review:
# PRODUCTION_ACME_APPROVED=yes
# Public mode additionally requires completed external launch gates:
# PUBLIC_LAUNCH_GATES_APPROVED=yes
DNS_RESOLVERS=1.1.1.1:53,8.8.8.8:53
ADMISSION_ENABLED=true
MAX_DOMAINS=1000
ADMISSIONS_PER_WINDOW=100
ADMISSION_WINDOW=24h
# systemd only (Compose fixes these):
HTTP_ADDR=127.0.0.1:8080
ASK_ADDR=127.0.0.1:8081
STATE_PATH=/var/lib/apex-redirect/state.db
TRUSTED_PROXIES=127.0.0.1/32,::1/128
